generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  role              UserRole           @default(CUSTOMER)
  branchId          String?
  banExpires        DateTime?
  banReason         String?
  banned            Boolean?           @default(false)
  addresses         Address[]
  cartItems         CartItem[]
  notifications     Notification[]
  orders            Order[]
  pushSubscriptions PushSubscription[]
  reviews           Review[]
  wishlistItems     WishlistItem[]
  accounts          Account[]
  sessions          Session[]
  branch            Branch?            @relation(fields: [branchId], references: [id])

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Branch {
  id           String   @id @default(cuid())
  name         String
  address      String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  city         String?
  state        String   @default("Tamil Nadu")
  googleMapUrl String?
  district     String   @default("Unknown")
  latitude     Float?
  longitude    Float?
  orders       Order[]
  users        User[]

  @@index([isActive])
  @@index([state])
}

model Category {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  thumbnailPublicId  String?
  thumbnailUrl       String?
  coverImagePublicId String?
  coverImageUrl      String?
  description        String?
  features           Json?
  layerImagePublicId String?
  layerImageUrl      String?
  layerVideoPublicId String?
  layerVideoUrl      String?
  products           Product[]
}

model Product {
  id                          String                 @id @default(cuid())
  name                        String
  slug                        String                 @unique
  isActive                    Boolean                @default(true)
  categoryId                  String
  createdAt                   DateTime               @default(now())
  isFeatured                  Boolean                @default(false)
  shortDescription            String[]               @default([])
  thumbnailPublicId           String
  thumbnailUrl                String
  type                        ProductType
  updatedAt                   DateTime               @updatedAt
  sectionHeading              String
  comfortLevel                ComfortLevel?
  firmness                    Firmness?
  healthBenefits              HealthBenefit[]        @default([])
  recommendedPositions        SleepingPosition[]     @default([])
  allowCustomSize             Boolean                @default(false)
  customSizePricing           Json?
  maxLength                   Int?
  maxWidth                    Int?
  minLength                   Int?
  minWidth                    Int?
  availableColors             String[]               @default([])
  featuredOrder               Int                    @default(0)
  defaultColor                String?
  customSizeMrpPricing        Json?
  baseMrpPerSqFtPerInch       Float?
  baseSalePricePerSqFtPerInch Float?
  cartItems                   CartItem[]
  orderItems                  OrderItem[]
  category                    Category               @relation(fields: [categoryId], references: [id])
  faqs                        ProductFaq[]
  images                      ProductImage[]
  sections                    ProductSection[]
  specifications              ProductSpecification[]
  variants                    ProductVariant[]
  reviews                     Review[]
  wishlistItems               WishlistItem[]

  @@index([isActive])
  @@index([isFeatured])
  @@index([categoryId])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  publicId  String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id              String           @id @default(cuid())
  productId       String
  mrp             Decimal          @db.Decimal(10, 2)
  salePrice       Decimal          @db.Decimal(10, 2)
  isDefault       Boolean          @default(false)
  cartItems       CartItem[]
  mattressVariant MattressVariant?
  orderItems      OrderItem[]
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  sofaVariant     SofaVariant?

  @@index([productId])
}

model MattressVariant {
  id        String         @id @default(cuid())
  variantId String         @unique
  sizeName  MattressSize
  width     Int
  length    Int
  thickness Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([sizeName])
  @@index([thickness])
}

model SofaVariant {
  id        String         @id @default(cuid())
  variantId String         @unique
  seatCount Int
  material  String
  shape     String?
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([seatCount])
  @@index([material])
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  label     String
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSection {
  id        String  @id @default(cuid())
  productId String
  type      String
  content   Json
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductFaq {
  id        String  @id @default(cuid())
  productId String
  question  String
  answer    String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id              String         @id @default(cuid())
  customerId      String?
  status          OrderStatus    @default(PENDING_PAYMENT)
  totalAmount     Decimal        @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime       @default(now())
  courierName     String?
  discountTotal   Decimal        @db.Decimal(10, 2)
  orderNumber     String         @unique
  shippingAddress Json
  shippingTotal   Decimal        @db.Decimal(10, 2)
  subTotal        Decimal        @db.Decimal(10, 2)
  trackingNumber  String?
  trackingUrl     String?
  updatedAt       DateTime       @updatedAt
  checkoutSource  CheckoutSource @default(CART)
  branchId        String?
  cancelReason    String?
  branch          Branch?        @relation(fields: [branchId], references: [id])
  customer        User?          @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  payments        Payment[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([branchId])
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  productId         String
  quantity          Int
  price             Decimal         @db.Decimal(10, 2)
  productName       String
  variantData       Json
  variantId         String?
  offerType         String?
  quantityFree      Int             @default(0)
  quantityPurchased Int             @default(0)
  totalPaid         Decimal         @default(0) @db.Decimal(10, 2)
  unitPrice         Decimal         @default(0) @db.Decimal(10, 2)
  color             String?
  order             Order           @relation(fields: [orderId], references: [id])
  product           Product         @relation(fields: [productId], references: [id])
  variant           ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  isDefault    Boolean  @default(false)
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CartItem {
  id         String          @id @default(cuid())
  userId     String?
  productId  String
  variantId  String?
  quantity   Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  customData Json?
  isCustom   Boolean         @default(false)
  color      String?
  sessionId  String?
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([userId])
}

model Promotion {
  id          String        @id @default(cuid())
  name        String
  description String?
  type        PromotionType
  isActive    Boolean       @default(true)
  startDate   DateTime?
  endDate     DateTime?
  productIds  String[]
  categoryIds String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  buyQuantity Int           @default(1)
  getQuantity Int           @default(1)
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  @@index([orderId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model DeliveryZone {
  id              String   @id @default(cuid())
  name            String
  pincodePrefixes String[]
  charge          Decimal  @db.Decimal(10, 2)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int
  title      String?
  comment    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

model HeroBanner {
  id                       String         @id @default(cuid())
  title                    String
  subtitle                 String?
  buttonText               String?
  buttonLink               String?
  backgroundImageUrl       String
  backgroundPublicId       String
  foregroundImageUrl       String?
  foregroundPublicId       String?
  order                    Int            @default(0)
  isActive                 Boolean        @default(true)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  mobileBackgroundImageUrl String?
  mobileBackgroundPublicId String?
  type                     HeroBannerType @default(DYNAMIC)
}

model Complaint {
  id            String   @id @default(cuid())
  userId        String?
  name          String
  email         String
  subject       String?
  message       String
  imageUrl      String?
  imagePublicId String?
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String
  razorpayRefundId  String?      @unique
  amount            Decimal      @db.Decimal(10, 2)
  status            RefundStatus
  reason            String?
  initiatedByUserId String?
  initiatedAt       DateTime     @default(now())
  processedAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorRole   String?
  action      String
  entityType  String
  entityId    String?
  description String?
  oldValues   Json?
  newValues   Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  event       String
  payload     Json
  status      String    @default("PENDING")
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status])
  @@index([event])
}

model EmailLog {
  id           String      @id @default(cuid())
  recipient    String
  subject      String
  status       EmailStatus
  errorMessage String?
  createdAt    DateTime    @default(now())

  @@index([recipient])
  @@index([status])
  @@index([createdAt])
}

enum UserRole {
  SUPER_ADMIN
  CUSTOMER
  BRANCH_ADMIN
}

enum ProductType {
  MATTRESS
  SOFA
}

enum MattressSize {
  SINGLE
  DOUBLE
  QUEEN
  KING
  CUSTOM
}

enum Firmness {
  SOFT
  MEDIUM_SOFT
  MEDIUM
  MEDIUM_FIRM
  FIRM
}

enum SleepingPosition {
  SIDE
  BACK
  STOMACH
  COMBINATION
}

enum ComfortLevel {
  PLUSH
  BALANCED
  SUPPORTIVE
}

enum HealthBenefit {
  ORTHOPEDIC
  BACK_PAIN_RELIEF
  PRESSURE_RELIEF
  COOLING
  MOTION_ISOLATION
}

enum OrderStatus {
  PENDING
  PENDING_PAYMENT
  PAID
  PENDING_ASSIGNMENT
  ASSIGNED
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  NONE
  INITIATED
  PROCESSING
  COMPLETED
  FAILED
}

enum CheckoutSource {
  CART
  BUY_NOW
}

enum PromotionType {
  BUY_X_GET_Y
}

enum HeroBannerType {
  DYNAMIC
  STATIC
}

enum EmailStatus {
  SENT
  FAILED
}
