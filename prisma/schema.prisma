// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  // BRANCH_ADMIN
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String
  role          UserRole  @default(CUSTOMER)

  isActive Boolean @default(true)

  orders        Order[]
  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  identifier String
  token      String                @unique
  type       VerificationTokenType
  expires    DateTime

  createdAt DateTime @default(now())

  @@id([identifier, token])
}

model Category {
  id   String @id @default(cuid())
  name String
  slug String @unique

  products Product[]
}

enum ProductType {
  MATTRESS
  SOFA
}

model Product {
  id String @id @default(cuid())

  name String
  slug String @unique

  type ProductType

  shortDescription  String[] @default([])
  // description       String?
  // price       Float
  categoryId        String
  thumbnailUrl      String
  thumbnailPublicId String

  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  category Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images         ProductImage[]
  variants       ProductVariant[]
  specifications ProductSpecification[]
  sectionHeading String
  sections       ProductSection[]
  faqs           ProductFaq[]

  firmness                Firmness?
  comfortLevel            ComfortLevel?
  healthBenefits          HealthBenefit[]    @default([])
  recommendedAgeGroups    AgeGroup[]         @default([])
  recommendedWeightGroups WeightGroup[]      @default([])
  recommendedPositions    SleepingPosition[] @default([])

  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
}

model ProductImage {
  id String @id @default(cuid())

  productId String

  url String

  publicId String

  sortOrder Int @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum MattressSize {
  SINGLE
  DOUBLE
  QUEEN
  KING
  CUSTOM
}

enum Firmness {
  SOFT
  MEDIUM_SOFT
  MEDIUM
  MEDIUM_FIRM
  FIRM
}

enum AgeGroup {
  KIDS
  TEEN
  ADULT
  SENIOR
}

enum WeightGroup {
  UNDER_60
  KG_60_80
  KG_80_100
  OVER_100
}

enum SleepingPosition {
  SIDE
  BACK
  STOMACH
  COMBINATION
}

enum ComfortLevel {
  PLUSH
  BALANCED
  SUPPORTIVE
}

enum HealthBenefit {
  ORTHOPEDIC
  BACK_PAIN_RELIEF
  PRESSURE_RELIEF
  COOLING
  MOTION_ISOLATION
}

model ProductVariant {
  id String @id @default(cuid())

  productId String

  mrp       Decimal @db.Decimal(10, 2)
  salePrice Decimal @db.Decimal(10, 2)

  isDefault Boolean @default(false)

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  mattressVariant MattressVariant?
  sofaVariant     SofaVariant?
  // orders          Order[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
}

model MattressVariant {
  id String @id @default(cuid())

  variantId String @unique

  sizeName MattressSize

  width  Int
  length Int

  thickness Int

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([sizeName])
  @@index([thickness])
}

model SofaVariant {
  id String @id @default(cuid())

  variantId String @unique

  seatCount Int

  material String

  // color String

  shape String?

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  // @@index([color])

  @@index([seatCount])
  @@index([material])
}

model ProductSpecification {
  id String @id @default(cuid())

  productId String

  label String
  value String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSection {
  id String @id @default(cuid())

  productId String

  // title String

  type String

  content Json

  sortOrder Int @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductFaq {
  id String @id @default(cuid())

  productId String

  question String
  answer   String

  sortOrder Int @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  PENDING
  PENDING_PAYMENT
  PAID
  PENDING_ASSIGNMENT
  ASSIGNED
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_INITIATED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CheckoutSource {
  CART
  BUY_NOW
}

model Order {
  id String @id @default(cuid())

  orderNumber String @unique

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  status OrderStatus @default(PENDING_PAYMENT)
  checkoutSource CheckoutSource @default(CART)

  subTotal      Decimal @db.Decimal(10, 2)
  discountTotal Decimal @db.Decimal(10, 2)
  shippingTotal Decimal @db.Decimal(10, 2)
  totalAmount   Decimal @db.Decimal(10, 2)

  shippingAddress Json
  notes           String?

  courierName    String?
  trackingNumber String?
  trackingUrl    String?

  items    OrderItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String?

  variant ProductVariant? @relation(fields: [variantId], references: [id])

  quantity Int

  productName String
  variantData Json

  price Decimal @db.Decimal(10, 2)

  quantityPurchased Int      @default(0)
  quantityFree      Int      @default(0)
  unitPrice         Decimal  @db.Decimal(10, 2) @default(0)
  totalPaid         Decimal  @db.Decimal(10, 2) @default(0)
  offerType         String?
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDefault    Boolean  @default(false)
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, productId, variantId])
}

enum PromotionType {
  BUY_X_GET_Y
}

model Promotion {
  id          String        @id @default(cuid())
  name        String
  description String?
  type        PromotionType
  isActive    Boolean       @default(true)
  startDate   DateTime?
  endDate     DateTime?
  buyQuantity Int           @default(1)
  getQuantity Int           @default(1)
  productIds  String[]
  categoryIds String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}
